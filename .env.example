# Required for Google Drive synchronization
GOOGLE_DRIVE_ROOT_FOLDER_ID=replace_with_root_folder_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Optional AI metadata enrichment. The sync works safely without these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_DOCUMENTS=20

# Optional public-link network verification. Permission checks always run.
VERIFY_PUBLIC_LINKS=false
